{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "noFallthroughCasesInSwitch": true,
    // game-rules.js is plain JS, imported by both main.js (browser) and the
    // spec tests (typecheck); allowJs lets tsc infer its shape for the latter.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["*.ts", "*.js", "spec", "scripts"]
}
